# Sao chép thành apps/web/.env.local, điền cấu hình dự án rồi khởi động lại Vite.
# Chỉ dùng publishable key hoặc legacy anon key. Không dùng service_role/secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

VITE_OFFICIAL_HOTLINE=0349.481.256
VITE_HOTLINE_CONFIRMED=true
