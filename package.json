{
  "name": "thai-dang-events-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types packages/shared/test/business-rules.test.ts && node --experimental-strip-types packages/shared/test/event-workflow.test.ts",
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && node scripts/copy-dist.js",
    "preview": "npm run preview --workspace=web",
    "test:db": "node --test apps/web/test/event-database.test.mjs",
    "test:accounts": "node --test apps/web/test/customer-password-edge.test.mjs"
  },
  "keywords": [
    "thai-dang",
    "event-management",
    "wedding-tent-rental",
    "inventory-scheduling"
  ],
  "author": "Thái Đăng Engineering Team",
  "license": "UNLICENSED"
}
