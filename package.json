{
  "name": "thai-dang-events-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types packages/shared/test/business-rules.test.ts",
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/dist')){fs.cpSync('apps/web/dist', 'dist', {recursive:true});}\"",
    "preview": "npm run preview --workspace=web"
  },
  "keywords": [
    "thai-dang",
    "event-management",
    "wedding-tent-rental",
    "inventory-scheduling"
  ],
