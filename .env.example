# ==============================================================================
# HỆ THỐNG QUẢN LÝ SỰ KIỆN NHÀ RẠP THÁI ĐĂNG - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# NGUYÊN TẮC AN TOÀN:
# 1. KHÔNG lưu trữ Supabase service_role key hoặc database password trong file này.
# 2. KHÔNG đưa credentials thật vào mã nguồn Git hoặc ứng dụng Android APK.
# 3. Phân tách rõ ràng giữa Development, Preview và Production.
# ==============================================================================

# --- PHÂN ĐỊNH MÔI TRƯỜNG ---
# Giá trị hợp lệ: development | preview | production
NODE_ENV=development
VITE_APP_ENV=development

# --- CẤU HÌNH SUPABASE CLOUD (DÙNG CHUNG WEB VÀ ANDROID) ---
# [Development]: Dùng Supabase Local (npx supabase start) hoặc Dev Cloud Project
# [Preview / Staging]: Dùng Supabase Staging Project (không dùng chung DB Production)
# [Production]: Dùng Supabase Production Project với tự động backup
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# --- CẤU HÌNH CONTACT CHÍNH THỨC (CHỜ XÁC NHẬN) ---
# Số chính thức cần dùng: [CHỦ ĐƠN VỊ XÁC NHẬN SỐ NÀY]
# Khi chủ đơn vị xác nhận, cập nhật biến này và chạy sync lên site_settings
VITE_OFFICIAL_HOTLINE=0988 112 233
VITE_HOTLINE_CONFIRMED=false

# --- CẤU HÌNH MÁY CHỦ PHÁT TRIỂN & DEPLOYMENT ---
PORT=5173
HOST=0.0.0.0
TIMEZONE=Asia/Ho_Chi_Minh

# --- CẤU HÌNH CHO ỨNG DỤNG ANDROID (REACT NATIVE / EXPO / NATIVE) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
